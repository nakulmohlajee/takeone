# Required — Gemini API (script, images, TTS, Lyria, translate)
GEMINI_API_KEY=

# Google Cloud project + media bucket (upload, render, Chirp batch)
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=

# Optional — YouTube channel style pull
YOUTUBE_API_KEY=

# Cloud Run worker job name (production). Empty → in-process workers (local).
TAKEONE_WORKER_JOB=takeone-worker
CLOUD_RUN_REGION=us-central1

# Force in-process workers even in production (debug)
# TAKEONE_WORKER_INLINE=1

# Abuse controls
TAKEONE_DAILY_CAP=200
# TAKEONE_DEMO_PASSCODE=judges-only

# Render
MAX_RENDER_SECONDS=2400
PORT=8080
NODE_ENV=development
