# TakeOne — render worker image (Cloud Run Job takeone-worker).
# Only FFmpeg, fonts, the esbuild-bundled worker and its few runtime deps — no Vite UI,
# no React/MediaPipe/tsx — so job cold starts pull a much smaller image.
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --legacy-peer-deps --ignore-scripts

COPY tsconfig.json ./tsconfig.json
COPY server ./server
COPY src ./src
COPY scripts/build-worker.mjs ./scripts/build-worker.mjs
RUN node scripts/build-worker.mjs

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fonts-dejavu-core \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/dist-worker/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund --legacy-peer-deps

COPY --from=build /app/dist-worker ./dist-worker
COPY public ./public
# Robust Video Matting model for virtual-background matte jobs.
COPY server/matting/models ./server/matting/models

CMD ["node", "dist-worker/worker.mjs"]
